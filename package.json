{
  "name": "portfolio-lms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio website with an integrated LMS module.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"apps/web/**/*.css\"",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"apps/web/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"apps/web/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "dependencies": {
    "railway": "^3.11.0"
  }
}
