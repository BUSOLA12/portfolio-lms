# Express API environment.
# Copy to .env for local development. Real values are set per service in Railway.

# ---------- Runtime ----------
NODE_ENV=development
PORT=4000

# ---------- Database ----------
# Railway supplies this for the managed Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_lms

# ---------- Web origin ----------
# The Next.js origin. Used for CORS and for building deep links in emails.
WEB_ORIGIN=http://localhost:3000

# ---------- Auth sessions ----------
# Secret used to hash auth session tokens before storage. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=
AUTH_SESSION_COOKIE_NAME=auth_session
# How long a login lasts. Default 30 days when unset.
AUTH_SESSION_TTL_DAYS=30
# Cookie domain. Depends on whether the API sits on a subdomain of the web app
# or a separate domain — still undecided, see CLAUDE.md "Still undecided".
AUTH_COOKIE_DOMAIN=
# SameSite for the auth cookie. `lax` while the API is same-site with the web
# app; a separate domain would need `none`, which browsers honour only over
# HTTPS. Same undecided question as AUTH_COOKIE_DOMAIN above.
AUTH_COOKIE_SAMESITE=lax

# Secret used to hash one-time tokens (guardian invitation, email
# verification, password reset) before storage. Separate from the auth session
# secret: different lifetimes, different blast radius if either leaks. Generate
# the same way. MUST be set in Railway before step 1.6 sends real invitations.
ONE_TIME_TOKEN_SECRET=
# How long an invitation token stays valid. Default 7 days when unset.
GUARDIAN_INVITATION_TTL_DAYS=7

# ---------- Email ----------
# Transport. `resend` sends for real; `console` transmits nothing and only logs,
# for local work without credentials. There is no default — an unset value
# throws rather than silently sending nothing.
EMAIL_PROVIDER=resend
# Resend API key, from the Resend dashboard.
EMAIL_API_KEY=
# Sender address, on a domain verified in Resend with SPF and DKIM configured.
# Format: "Name <address@domain>".
EMAIL_FROM=

# ---------- Payments ----------
# Gateway not yet chosen: Paystack or Flutterwave. Decided before step 4.2.
PAYMENT_GATEWAY=
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=
