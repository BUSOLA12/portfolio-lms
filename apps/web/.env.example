# Next.js environment.
# Copy to .env.local for local development. Real values are set per service in Railway.

# ---------- API ----------
# Base URL of the Express API. Public because client components call it directly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Site ----------
# Canonical origin, used for metadata, sitemap, and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
